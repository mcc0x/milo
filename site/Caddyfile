{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:80} {
	root * {{.DIST_DIR}}
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		-Server
	}
	# Next.js names every file under /_next/static by its content or its build.
	header /_next/static/* {
		Cache-Control "public, max-age=31536000, immutable"
		match status 2xx 304
	}
	file_server

	handle_errors 404 {
		rewrite /404.html
		file_server
	}
}
